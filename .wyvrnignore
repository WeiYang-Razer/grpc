.idea/
build/
wyvrn_internal/
wyvrn.lock
CMakePresets.json
CMakeUserPresets.json
*.tmp
*.log
cmake-out/

# gRPC tests / docs / examples / dev-only tooling
test/
doc/
examples/
tools/
templates/
summerofcode/
fuzztest/

# Non-C++ language bindings
src/python/
src/php/
src/ruby/
src/objective-c/
src/csharp/

# Bazel-only files (we publish the CMake build)
.bazelci/
.bcr/
bazel/
*.bzl
WORKSPACE
WORKSPACE.bazel
MODULE.bazel
MODULE.bazel.lock
BUILD
BUILD.bazel
*.BUILD

# third_party — drop subdirs we don't need for a bundled C++ build
third_party/benchmark/
third_party/googletest/
third_party/protoc-gen-validate/
