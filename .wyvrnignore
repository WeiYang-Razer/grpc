third_party/objective_c/
third_party/toolchains/

# third_party — keep opentelemetry-cpp ONLY when shipping the otel option;
# the recipe handles the OFF-by-default case so it's safe to drop.
# Comment this out when publishing the build_otel_plugin=true variant.
third_party/opentelemetry-cpp/
